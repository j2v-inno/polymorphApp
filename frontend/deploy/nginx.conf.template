# Overrides nginx:alpine's default /etc/nginx/conf.d/default.conf. The stock
# config only does root+index — no fallback for a path that isn't a real
# file — so any deep-link mode path (BASE_PATH_PLACEHOLDER/acquisition,
# /batch-split, etc. — see mode-path.ts) 404s before index.html/single-spa
# ever loads, since those are client-side routes, not real files on disk.
#
# BASE_PATH_PLACEHOLDER is replaced by the Dockerfile's build step (sed),
# same convention as index.html.
server {
    listen 80;
    server_name localhost;

    location BASE_PATH_PLACEHOLDER/ {
        root /usr/share/nginx/html;
        try_files $uri $uri/ BASE_PATH_PLACEHOLDER/index.html;
    }

    # index.html's own URL never changes between deploys (unlike the JS
    # bundle, which now embeds its version in the filename — see Dockerfile),
    # so it's the one thing a CDN/edge cache in front of the real domain could
    # still serve stale indefinitely. Explicitly forbidding caching here is
    # belt-and-suspenders — whether the CDN actually honors it depends on that
    # distribution's own cache policy, which isn't visible/controllable from
    # here.
    location = BASE_PATH_PLACEHOLDER/index.html {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-store, must-revalidate" always;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
