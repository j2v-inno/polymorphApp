PORT=4100

# uw-be service credential (§4) — Orion Sanctum-style personal access token.
# Format: "<id>|<plaintext-token>". Never expose this to the browser.
# Default points at the local mock (`pnpm dev:mock-uwbe`, see ../mock-uwbe) so you
# can run the whole pipeline without a real Orion project. Point at a real
# environment's URL/token to test against actual uw-be.
UWBE_BASE_URL=http://localhost:4200/
UWBE_API_TOKEN=1|replace-me

# Comma-separated origins allowed to call this backend from the browser.
ALLOWED_ORIGINS=http://localhost:9100,http://localhost:3000

# §13 blocker #1 (owner: Bhanu) — not yet decided. "flag" completes with
# meta_data.acquisition_check=fail; "reject" sets file_status=O (on-hold).
ACQUISITION_GATE_MODE=flag
ACQUISITION_MIN_AVG_CHARS_PER_PAGE=20

BATCH_SPLIT_MIN_CHUNKS=2
BATCH_SPLIT_MAX_CHUNKS=5
BATCH_SPLIT_TARGET_PAGES_PER_CHUNK=20
# task_code values in the workflow graph (§6.3.1) — confirm against the real
# get-all-tasks response shape for the target workflow.
BATCH_SPLIT_DOWNLOAD_TASK_CODE=DOWNLOAD
BATCH_SPLIT_MANUAL_FIX_TASK_CODE=MANUAL_FIX
# splitMethod="by-chapter" routes every child here instead of download-ready/
# manual-fix, so each chapter gets its own qualification pass after the split
# (register -> batch -> qualify-each-chapter -> download-each-chapter).
BATCH_SPLIT_QUALIFICATION_TASK_CODE=QUALIFICATION
# by-chapter routes every child here instead of qualification directly — PDF
# text -> XML/JSON runs here first, then routes on to qualification above.
BATCH_SPLIT_TRANSFORM_TASK_CODE=TRANSFORMATION
# Tested against outline/bookmark titles first, page text if there's no outline.
# Tune per book/project — chapter heading style varies a lot and this can't be
# known generically. Default covers "CHAPTER 1"/"Chapter One"/"Part IV" and
# bare-roman-numeral POV-chapter titles like "I Jason" (common in multi-POV YA).
BATCH_SPLIT_CHAPTER_HEADING_PATTERN=^(chapter|part)\s+([0-9]+|[ivxlcdm]+|one|two|three|four|five|six|seven|eight|nine|ten)\b|^[ivxlcdm]+[.:]?\s+\S+

# Who is calling. Every /api call carries the app token Orion's page gave the
# screen; this server exchanges it with Orion using UWBE_API_TOKEN above.
# This app's code on Orion's Web Apps page — a token for another app is refused.
ORION_WEB_APP_CODE=transapp
# The Orion this server trusts, as Orion names itself (its APP_URL). Set it in
# every real deployment so production accepts only production's tokens.
# ORION_ISSUER=https://orion.example.com
# Opened in its own tab, the app is handed a launch code on its link (?ct=).
# This server exchanges it with Orion once and keeps its own session with that
# tab for this many minutes. Orion's code itself lasts an hour.
TAB_SESSION_MINUTES=480
